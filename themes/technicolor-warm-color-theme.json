  "tokenColors": [
    // ── Comments ──
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A6E50",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment keyword",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation punctuation.definition",
        "comment.block.documentation variable",
        "storage.type.class.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#8A7E60"
      }
    },

    // ── Strings ──
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#90A878"
      }
    },
    {
      "name": "Template string expression",
      "scope": [
        "string.template punctuation.definition.template-expression",
        "string.interpolated punctuation.section.embedded",
        "meta.template.expression",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#90A878",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#90A878",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String punctuation",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#90A878"
      }
    },

    // ── Regular Expressions ──
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },
    {
      "name": "Regex group",
      "scope": [
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },

    // ── Constants ──
    {
      "name": "Constant (numeric, boolean, null)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },

    // ── Keywords ──
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#E8A030"
      }
    },
    {
      "name": "Control keyword",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#E8A030",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Return / yield / await",
      "scope": [
        "keyword.control.return",
        "keyword.control.yield",
        "keyword.control.await"
      ],
      "settings": {
        "foreground": "#E8A030",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator keyword (new, delete, typeof, instanceof, in, of)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.expression.in",
        "keyword.operator.expression.of",
        "keyword.operator.expression.void",
        "keyword.operator.expression.keyof",
        "keyword.operator.expression.is"
      ],
      "settings": {
        "foreground": "#E8A030"
      }
    },

    // ── Operators ──
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type.annotation",
        "keyword.operator.optional"
      ],
      "settings": {
        "foreground": "#E8A030"
      }
    },

    // ── Storage / Modifiers ──
    {
      "name": "Storage type (class, function, var, let, const)",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.namespace",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#E8A030"
      }
    },
    {
      "name": "Storage modifier (async, static, public, private, etc.)",
      "scope": [
        "storage.modifier",
        "storage.modifier.async",
        "storage.modifier.static",
        "keyword.other.debugger"
      ],
      "settings": {
        "foreground": "#E8A030",
        "fontStyle": "italic"
      }
    },

    // ── Functions ──
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#7EB540"
      }
    },
    {
      "name": "Method call",
      "scope": [
        "meta.method-call entity.name.function",
        "meta.function-call.method entity.name.function"
      ],
      "settings": {
        "foreground": "#7EB540"
      }
    },
    {
      "name": "Built-in function / magic method",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#7EB540",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Arrow function",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#E8A030"
      }
    },

    // ── Variables ──
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#B0A090"
      }
    },
    {
      "name": "Variable object property",
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D4C8A0"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#B0A090",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variable (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#B0A090",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Constant variable (UPPER_CASE)",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },

    // ── Types / Classes ──
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "entity.name.type.module",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B8A878",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Built-in type",
      "scope": [
        "support.type.builtin",
        "support.type.primitive",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#B8A878"
      }
    },
    {
