{
  "name": "technicolor",
  "displayName": "Technicolor",
  "description": "Eight bold dark themes drawn from a century of film.",
  "version": "0.2.1",
  "publisher": "oppositefish",
  "license": "MIT",
  "author": {
    "name": "Kirill Ragozin",
    "email": "ragozin@hey.com"
  },
  "homepage": "https://github.com/JazzJackrabbit/technicolor-vscode#readme",
  "bugs": {
    "url": "https://github.com/JazzJackrabbit/technicolor-vscode/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "scripts": {
    "assets": "python3 scripts/build-assets.py",
    "lint": "python3 scripts/validate-themes.py",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.10.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "dark theme",
    "retro",
    "70s",
    "neon",
    "warm",
    "technicolor",
    "kodachrome",
    "psychedelic",
    "color theme"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1A1A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JazzJackrabbit/technicolor-vscode.git"
  },
  "contributes": {
    "themes": [
      {
        "label": "Technicolor Deep",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-deep-color-theme.json"
      },
      {
        "label": "Technicolor Kodachrome",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-kodachrome-color-theme.json"
      },
      {
        "label": "Technicolor Warm",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-warm-color-theme.json"
      },
      {
        "label": "Technicolor Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-neon-color-theme.json"
      },
      {
        "label": "Technicolor Marquee",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-marquee-color-theme.json"
      },
      {
        "label": "Technicolor Drive-In",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-drivein-color-theme.json"
      },
      {
        "label": "Technicolor Psychedelic",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-psychedelic-color-theme.json"
      },
      {
        "label": "Technicolor Silent Era",
        "uiTheme": "vs-dark",
        "path": "./themes/technicolor-silentera-color-theme.json"
      }
    ]
  }
}
